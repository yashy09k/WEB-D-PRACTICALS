<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Soundboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sekuya&family=IBM+Plex+Mono:wght@400;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <style>
    @keyframes faFlip360 {
      0% { transform: rotateY(0deg); }
      100% { transform: rotateY(360deg); }
    }
    .fa-flip-360 {
      animation: faFlip360 2s ease-in-out infinite;
      display: inline-block;
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 9999;
    }
    .topbar::-webkit-scrollbar { height: 0; }
    .section[data-temp="warm"] { background: rgba(251,86,7,0.012); }
    .section[data-temp="cool"] { background: rgba(131,56,236,0.012); }
    .pad::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(233,236,239,0.06), transparent 70%);
      opacity: 0;
      transition: opacity .15s;
      pointer-events: none;
    }
    .pad.active::after { opacity: 1; }
    .pad.active { transform: scale(0.96); background: #2c3238; }
    .pad.active .viz-bar { background: rgba(233,236,239,0.03); }
    .pad[data-row="0"] { border-color: rgba(251,86,7,0.45); }
    .pad[data-row="0"]:hover { border-color: #FB5607; }
    .pad[data-row="0"].active { border-color: #FB5607; box-shadow: 0 0 20px -6px #FB5607; }
    .pad[data-row="0"] .label { color: #FB5607; }
    .pad[data-row="1"] { border-color: rgba(253,141,82,0.4); }
    .pad[data-row="1"]:hover { border-color: #FD8D52; }
    .pad[data-row="1"].active { border-color: #FD8D52; box-shadow: 0 0 20px -6px #FD8D52; }
    .pad[data-row="1"] .label { color: #FD8D52; }
    .pad[data-row="2"] { border-color: rgba(131,56,236,0.45); }
    .pad[data-row="2"]:hover { border-color: #8338EC; }
    .pad[data-row="2"].active { border-color: #8338EC; box-shadow: 0 0 20px -6px #8338EC; }
    .pad[data-row="2"] .label { color: #8338EC; }
    .pad[data-row="3"] { border-color: rgba(168,110,232,0.4); }
    .pad[data-row="3"]:hover { border-color: #A86EE8; }
    .pad[data-row="3"].active { border-color: #A86EE8; box-shadow: 0 0 20px -6px #A86EE8; }
    .pad[data-row="3"] .label { color: #A86EE8; }
    .pad:hover { box-shadow: 0 0 18px -4px rgba(233,236,239,0.25), 0 0 6px -2px rgba(233,236,239,0.15); }
    .nav-links a.active-nav { color: #E9ECEF; background: #2c3136; }
    .divider { max-width: 880px; margin: 0 auto; height: 1px; background: linear-gradient(90deg, transparent, #2c3136 20%, #2c3136 80%, transparent); }
  </style>
</head>
<body class="bg-[#212529] text-[#E9ECEF] min-h-screen overflow-x-hidden flex flex-col" style="font-family:'IBM Plex Mono',monospace">

  <div class="text-center pt-12 pb-5 px-7">
    <i class="fa-solid fa-music fa-flip-360 text-white text-3xl block mb-2.5"></i>
    <h1 class="text-[42px] font-normal tracking-wide leading-tight" style="font-family:'Sekuya',sans-serif">
      <span class="text-[#FB5607]">Interactive</span>
      <span class="text-[#8338EC]">Soundboard</span>
    </h1>
  </div>

  <nav class="topbar sticky top-0 z-[100] bg-[#181b1e] border-b border-[#2c3136] px-7 flex items-center justify-center gap-1 h-12 overflow-x-auto">
    <div class="nav-links flex gap-0.5 shrink-0" id="navLinks">
      <a href="#drums" class="no-underline text-[11px] font-semibold text-[#6c757d] px-3.5 py-1.5 rounded hover:text-[#adb5bd] hover:bg-[#2c3136] transition-colors whitespace-nowrap tracking-tight">
        <span class="inline-block w-1.5 h-1.5 rounded-full mr-1.5 align-middle" style="background:#FB5607"></span>Drums
      </a>
      <a href="#percussion" class="no-underline text-[11px] font-semibold text-[#6c757d] px-3.5 py-1.5 rounded hover:text-[#adb5bd] hover:bg-[#2c3136] transition-colors whitespace-nowrap tracking-tight">
        <span class="inline-block w-1.5 h-1.5 rounded-full mr-1.5 align-middle" style="background:#FD8D52"></span>Percussion
      </a>
      <a href="#synth" class="no-underline text-[11px] font-semibold text-[#6c757d] px-3.5 py-1.5 rounded hover:text-[#adb5bd] hover:bg-[#2c3136] transition-colors whitespace-nowrap tracking-tight">
        <span class="inline-block w-1.5 h-1.5 rounded-full mr-1.5 align-middle" style="background:#8338EC"></span>Synth
      </a>
      <a href="#fx" class="no-underline text-[11px] font-semibold text-[#6c757d] px-3.5 py-1.5 rounded hover:text-[#adb5bd] hover:bg-[#2c3136] transition-colors whitespace-nowrap tracking-tight">
        <span class="inline-block w-1.5 h-1.5 rounded-full mr-1.5 align-middle" style="background:#A86EE8"></span>FX
      </a>
    </div>
  </nav>

  <main>
    <section class="section py-9 px-7 pb-5 max-w-[880px] mx-auto" id="drums" data-temp="warm"></section>
    <div class="divider"></div>
    <section class="section py-9 px-7 pb-5 max-w-[880px] mx-auto" id="percussion" data-temp="warm"></section>
    <div class="divider"></div>
    <section class="section py-9 px-7 pb-5 max-w-[880px] mx-auto" id="synth" data-temp="cool"></section>
    <div class="divider"></div>
    <section class="section py-9 px-7 pb-5 max-w-[880px] mx-auto" id="fx" data-temp="cool"></section>
  </main>

  <footer class="mt-auto text-center py-7 pb-6 border-t border-[#2c3136] bg-[#181b1e]">
    <div class="text-xs text-[#6c757d] leading-[1.8] tracking-tight">
      <strong class="text-[#adb5bd] font-semibold">USN:</strong> CS25062<br>
      <strong class="text-[#adb5bd] font-semibold">MDM:</strong> WEB DEVELOPMENT<br>
      <strong class="text-[#adb5bd] font-semibold">SECTION:</strong> A
    </div>
  </footer>

<script>
var SECTIONS=[
  {id:'drums',title:'Drums',row:0,color:'#FB5607',temp:'warm',pads:[
    {key:'Q',label:'Kick',sub:'low boom',type:'kick'},
    {key:'W',label:'Snare',sub:'crack',type:'snare'},
    {key:'E',label:'Hi-Hat',sub:'closed',type:'hihat'},
    {key:'R',label:'Open Hat',sub:'sizzle',type:'openhat'}
  ]},
  {id:'percussion',title:'Percussion',row:1,color:'#FD8D52',temp:'warm',pads:[
    {key:'A',label:'Clap',sub:'reverb snap',type:'clap'},
    {key:'S',label:'Tom',sub:'mid hit',type:'tom'},
    {key:'D',label:'Rim',sub:'click',type:'rim'},
    {key:'F',label:'Cowbell',sub:'ding',type:'cowbell'}
  ]},
  {id:'synth',title:'Synth',row:2,color:'#8338EC',temp:'cool',pads:[
    {key:'Z',label:'Bass',sub:'sub rumble',type:'bass'},
    {key:'X',label:'Stab',sub:'saw chord',type:'stab'},
    {key:'C',label:'Bleep',sub:'sine ping',type:'bleep'},
    {key:'V',label:'Laser',sub:'descending',type:'laser'}
  ]},
  {id:'fx',title:'FX',row:3,color:'#A86EE8',temp:'cool',pads:[
    {key:'1',label:'Whoosh',sub:'noise sweep',type:'whoosh'},
    {key:'2',label:'Zap',sub:'electric',type:'zap'},
    {key:'3',label:'Siren',sub:'rising',type:'siren'},
    {key:'4',label:'Glitch',sub:'bitcrush',type:'glitch'}
  ]}
];

var audioCtx=null,masterGain=null,activeSources=[],padEls={};

SECTIONS.forEach(function(sec){
  var container=document.getElementById(sec.id);
  var head=document.createElement('div');
  head.className='flex items-center gap-2.5 mb-4';
  head.innerHTML='<span class="w-[3px] h-5 rounded-sm" style="background:'+sec.color+'"></span><h2 class="text-xl font-normal tracking-wide" style="font-family:Sekuya,sans-serif;color:'+sec.color+'">'+sec.title+'</h2><span class="text-[10px] text-[#495057] bg-[#2c3136] px-[7px] py-[2px] rounded-sm">'+sec.pads.length+' pads</span>';
  container.appendChild(head);
  var grid=document.createElement('div');
  grid.className='grid grid-cols-2 gap-2.5';
  sec.pads.forEach(function(p){
    var el=document.createElement('div');
    el.className='pad relative bg-[#282d32] border-2 border-[#343a40] rounded-md pt-[18px] px-3.5 pb-3 cursor-pointer select-none overflow-hidden flex flex-col justify-between min-h-[110px] transition-transform duration-[60ms]';
    el.dataset.row=sec.row;
    el.dataset.type=p.type;
    el.innerHTML='<span class="key absolute top-[7px] right-2 text-[10px] font-semibold text-[#495057] bg-[#1e2124] px-1.5 py-[2px] rounded-sm border border-[#2c3136] leading-none">'+p.key+'</span><div><div class="label text-[13px] font-semibold leading-tight mb-1.5">'+p.label+'</div><div class="sub text-[10px] text-[#8a8f94] tracking-tight">'+p.sub+'</div></div><div class="viz-bar absolute bottom-0 left-0 right-0 h-[3px] overflow-hidden"><canvas class="waveform-canvas w-full h-full block"></canvas></div>';
    el.addEventListener('mousedown',function(){triggerPad(p.key)});
    el.addEventListener('touchstart',function(e){e.preventDefault();triggerPad(p.key)},{passive:false});
    grid.appendChild(el);
    padEls[p.key]=el;
  });
  container.appendChild(grid);
});

function ensureAudio(){
  if(audioCtx)return;
  audioCtx=new(window.AudioContext||window.webkitAudioContext)();
  masterGain=audioCtx.createGain();
  masterGain.gain.value=0.7;
  masterGain.connect(audioCtx.destination);
}

function makeNoise(dur,fade){
  var len=audioCtx.sampleRate*dur;
  var buf=audioCtx.createBuffer(1,len,audioCtx.sampleRate);
  var d=buf.getChannelData(0);
  for(var i=0;i<len;i++)d[i]=Math.random()*2-1;
  var src=audioCtx.createBufferSource();src.buffer=buf;
  if(fade){var g=audioCtx.createGain();g.gain.setValueAtTime(1,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+dur);src.connect(g);return{src:src,gain:g}}
  return{src:src,gain:null};
}

function synthKick(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.setValueAtTime(150,t);o.frequency.exponentialRampToValueAtTime(40,t+0.12);g.gain.setValueAtTime(1,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.4);o.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.4);return[o]}
function synthSnare(){var t=audioCtx.currentTime;var n=makeNoise(0.15,true),hpf=audioCtx.createBiquadFilter();hpf.type='highpass';hpf.frequency.value=2000;n.src.connect(hpf);hpf.connect(n.gain||masterGain);if(n.gain)n.gain.connect(masterGain);n.src.start(t);var o=audioCtx.createOscillator(),og=audioCtx.createGain();o.type='triangle';o.frequency.setValueAtTime(180,t);o.frequency.exponentialRampToValueAtTime(80,t+0.06);og.gain.setValueAtTime(0.7,t);og.gain.exponentialRampToValueAtTime(0.001,t+0.08);o.connect(og);og.connect(masterGain);o.start(t);o.stop(t+0.1);return[n.src,o]}
function synthHiHat(){var t=audioCtx.currentTime;var n=makeNoise(0.06,true),bpf=audioCtx.createBiquadFilter();bpf.type='bandpass';bpf.frequency.value=8000;bpf.Q.value=1.2;n.src.connect(bpf);bpf.connect(n.gain||masterGain);if(n.gain)n.gain.connect(masterGain);n.src.start(t);return[n.src]}
function synthOpenHat(){var t=audioCtx.currentTime;var n=makeNoise(0.3,true),bpf=audioCtx.createBiquadFilter();bpf.type='bandpass';bpf.frequency.value=7000;bpf.Q.value=0.8;n.src.connect(bpf);bpf.connect(n.gain||masterGain);if(n.gain)n.gain.connect(masterGain);n.src.start(t);return[n.src]}
function synthClap(){var t=audioCtx.currentTime;var n=makeNoise(0.12,true),bpf=audioCtx.createBiquadFilter();bpf.type='bandpass';bpf.frequency.value=1500;bpf.Q.value=0.6;n.src.connect(bpf);var g2=audioCtx.createGain();g2.gain.setValueAtTime(0.8,t);g2.gain.setValueAtTime(0,t+0.015);g2.gain.setValueAtTime(1,t+0.03);g2.gain.exponentialRampToValueAtTime(0.001,t+0.12);bpf.connect(g2);g2.connect(masterGain);n.src.start(t);return[n.src]}
function synthTom(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.setValueAtTime(200,t);o.frequency.exponentialRampToValueAtTime(80,t+0.15);g.gain.setValueAtTime(0.9,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.25);o.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.25);return[o]}
function synthRim(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='square';o.frequency.value=800;g.gain.setValueAtTime(0.4,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.03);o.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.04);return[o]}
function synthCowbell(){var t=audioCtx.currentTime;var o1=audioCtx.createOscillator(),o2=audioCtx.createOscillator(),g=audioCtx.createGain();o1.type='square';o2.type='square';o1.frequency.value=560;o2.frequency.value=845;g.gain.setValueAtTime(0.35,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.3);o1.connect(g);o2.connect(g);g.connect(masterGain);o1.start(t);o2.start(t);o1.stop(t+0.3);o2.stop(t+0.3);return[o1,o2]}
function synthBass(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=55;g.gain.setValueAtTime(0.8,t);g.gain.setValueAtTime(0.8,t+0.15);g.gain.exponentialRampToValueAtTime(0.001,t+0.6);o.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.6);return[o]}
function synthStab(){var t=audioCtx.currentTime;var freqs=[220,277,330],g=audioCtx.createGain();g.gain.setValueAtTime(0.2,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.2);g.connect(masterGain);return freqs.map(function(f){var o=audioCtx.createOscillator();o.type='sawtooth';o.frequency.value=f;var lpf=audioCtx.createBiquadFilter();lpf.type='lowpass';lpf.frequency.setValueAtTime(3000,t);lpf.frequency.exponentialRampToValueAtTime(400,t+0.15);o.connect(lpf);lpf.connect(g);o.start(t);o.stop(t+0.25);return o})}
function synthBleep(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=1200;g.gain.setValueAtTime(0.3,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.12);o.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.12);return[o]}
function synthLaser(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(1500,t);o.frequency.exponentialRampToValueAtTime(100,t+0.3);g.gain.setValueAtTime(0.25,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.35);o.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.35);return[o]}
function synthWhoosh(){var t=audioCtx.currentTime;var n=makeNoise(0.4,false),bpf=audioCtx.createBiquadFilter();bpf.type='bandpass';bpf.Q.value=2;bpf.frequency.setValueAtTime(200,t);bpf.frequency.exponentialRampToValueAtTime(6000,t+0.2);bpf.frequency.exponentialRampToValueAtTime(200,t+0.4);var g=audioCtx.createGain();g.gain.setValueAtTime(0.001,t);g.gain.linearRampToValueAtTime(0.5,t+0.15);g.gain.exponentialRampToValueAtTime(0.001,t+0.4);n.src.connect(bpf);bpf.connect(g);g.connect(masterGain);n.src.start(t);return[n.src]}
function synthZap(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(80,t);o.frequency.exponentialRampToValueAtTime(2000,t+0.04);o.frequency.exponentialRampToValueAtTime(300,t+0.1);g.gain.setValueAtTime(0.3,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.15);var lpf=audioCtx.createBiquadFilter();lpf.type='lowpass';lpf.frequency.value=4000;o.connect(lpf);lpf.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.15);return[o]}
function synthSiren(){var t=audioCtx.currentTime;var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.setValueAtTime(400,t);o.frequency.linearRampToValueAtTime(900,t+0.3);o.frequency.linearRampToValueAtTime(400,t+0.6);g.gain.setValueAtTime(0.3,t);g.gain.setValueAtTime(0.3,t+0.5);g.gain.exponentialRampToValueAtTime(0.001,t+0.65);o.connect(g);g.connect(masterGain);o.start(t);o.stop(t+0.65);return[o]}
function synthGlitch(){var t=audioCtx.currentTime,oscs=[];for(var i=0;i<6;i++){var o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='square';o.frequency.value=100+Math.random()*2000;var s=t+i*0.025;g.gain.setValueAtTime(0.15,s);g.gain.setValueAtTime(0,s+0.02);o.connect(g);g.connect(masterGain);o.start(s);o.stop(s+0.025);oscs.push(o)}return oscs}

var SYNTH_MAP={kick:synthKick,snare:synthSnare,hihat:synthHiHat,openhat:synthOpenHat,clap:synthClap,tom:synthTom,rim:synthRim,cowbell:synthCowbell,bass:synthBass,stab:synthStab,bleep:synthBleep,laser:synthLaser,whoosh:synthWhoosh,zap:synthZap,siren:synthSiren,glitch:synthGlitch};

function triggerPad(key){
  var pad=padEls[key];if(!pad)return;ensureAudio();
  var type=pad.dataset.type,synth=SYNTH_MAP[type];if(!synth)return;
  var sources=synth();for(var i=0;i<sources.length;i++)activeSources.push(sources[i]);
  pad.classList.add('active');drawWaveform(pad,type);
  setTimeout(function(){pad.classList.remove('active')},180);
}

function drawWaveform(pad,type){
  var canvas=pad.querySelector('.waveform-canvas');if(!canvas)return;
  var ctx=canvas.getContext('2d');canvas.width=canvas.offsetWidth*2;canvas.height=canvas.offsetHeight*2;
  var w=canvas.width,h=canvas.height;ctx.clearRect(0,0,w,h);
  var row=parseInt(pad.dataset.row),colors=['#FB5607','#FD8D52','#8338EC','#A86EE8'];
  ctx.strokeStyle=colors[row]||'#E9ECEF';ctx.lineWidth=1.5;ctx.beginPath();
  var seed=type.charCodeAt(0);
  for(var x=0;x<w;x++){var t=x/w,y;
    if(type==='kick'||type==='tom'||type==='bass'){y=Math.sin(t*12+seed)*Math.exp(-t*4)}
    else if(type==='snare'||type==='clap'||type==='hihat'||type==='openhat'||type==='rim'){y=(Math.random()-0.5)*Math.exp(-t*6)}
    else{y=Math.sin(t*(10+seed%20))*(1-t)*0.8}
    var py=h/2+y*h*0.4;if(x===0)ctx.moveTo(x,py);else ctx.lineTo(x,py)}
  ctx.stroke();
}

document.addEventListener('keydown',function(e){if(e.repeat)return;triggerPad(e.key.toUpperCase())});

var navLinks=document.querySelectorAll('#navLinks a');
var sectionEls=SECTIONS.map(function(s){return document.getElementById(s.id)});
function updateActiveNav(){var scrollY=window.scrollY+80,current=0;sectionEls.forEach(function(el,i){if(el.offsetTop<=scrollY)current=i});navLinks.forEach(function(a,i){if(i===current)a.classList.add('active-nav');else a.classList.remove('active-nav')})}
window.addEventListener('scroll',updateActiveNav,{passive:true});
updateActiveNav();
</script>
</body>
</html>
